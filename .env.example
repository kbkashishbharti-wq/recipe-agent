# Recipe Preparation Agent - Environment Configuration
# Copy this file to ".env" and fill in your real values.
# NEVER commit ".env" to version control.

# IBM watsonx.ai credentials
# Get your API key: https://cloud.ibm.com -> Manage -> Access (IAM) -> API keys
WATSONX_API_KEY=YOUR_IBM_CLOUD_API_KEY_HERE

# Get your Project ID: watsonx.ai -> your project -> Manage -> General -> Project ID
WATSONX_PROJECT_ID=YOUR_WATSONX_PROJECT_ID_HERE

# Regional endpoint
# Options: https://us-south.ml.cloud.ibm.com | https://eu-de.ml.cloud.ibm.com
#          https://eu-gb.ml.cloud.ibm.com    | https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model (recommended for IBM Cloud Lite plan)
GRANITE_MODEL_ID=ibm/granite-4-h-small

# LLM generation parameters (optional - defaults shown)
MAX_NEW_TOKENS=800
LLM_TEMPERATURE=0.7

# RAG / retrieval settings (optional - defaults shown)
RECIPE_DATA_PATH=./data/recipes.json
RAG_TOP_K=5
MIN_SIMILARITY_SCORE=0.0

# Flask server (optional - defaults shown)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False